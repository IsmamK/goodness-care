# Goodness Service — Next.js static export (output: 'export', trailingSlash: true)
# Place this file in the web root of the deployed `out/` folder.

RewriteEngine On
RewriteBase /

# Force HTTPS (uncomment if you have SSL configured)
# RewriteCond %{HTTPS} off
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Serve the matching file/directory as-is if it exists
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Route /about -> /about/ (folder with index.html), so links without a trailing slash still resolve
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.*[^/])$ /$1/ [L,R=301]

# Route /about/ -> /about/index.html explicitly (helps on servers without DirectoryIndex set)
RewriteCond %{REQUEST_FILENAME}index.html -f
RewriteRule ^(.*/)$ $1index.html [L]

# Try adding .html for extensionless requests (e.g. /some-file -> /some-file.html)
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*[^/])$ $1.html [L]

# Custom 404 page (Next static export writes 404.html at the root)
ErrorDocument 404 /404.html

# Correct MIME types (safety net in case the host's mime.types is incomplete)
<IfModule mod_mime.c>
  AddType application/json .json
  AddType application/pdf .pdf
  AddType image/webp .webp
  AddType image/avif .avif
  AddType image/svg+xml .svg
  AddType font/woff2 .woff2
</IfModule>

# Cache immutable hashed build assets aggressively
<IfModule mod_expires.c>
  ExpiresActive On
  <FilesMatch "^_next/static/">
    ExpiresDefault "access plus 1 year"
  </FilesMatch>
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|png|jpe?g|svg|webp|avif|ico|pdf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# Gzip compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
